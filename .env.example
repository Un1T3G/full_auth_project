# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres_pass@localhost:5432/full_auth_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Session & Security
SESSION_COOKIE_NAME=auth_session
SESSION_SECRET="super-secret-session-key-change-in-production-min-32-chars-long"
SESSION_TTL_DAYS=7

# MFA & Tickets
MFA_TICKET_SECRET="mfa-ticket-secret-key-change-in-production-min-32-chars"
MFA_APP_NAME="FullAuthApp"

# Mailer (SMTP / Ethereal)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="noreply@fullauth.local"

# OAuth Providers (fill when testing OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
